# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dispatch365?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=8h

# Login lockout
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Driver session grace (keeps session alive during IN_TRANSIT loads)
DRIVER_SESSION_GRACE_HOURS=24
