generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────

enum Role {
  SuperAdmin
  AgencyAdmin
  Dispatcher
  FleetAdmin
  Driver
}

enum LoadStatus {
  DRAFT
  ASSIGNED
  IN_TRANSIT
  PENDING_DELIVERY_CONFIRMATION
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DispatcherStatus {
  PENDING
  ACTIVE
  SUSPENDED_TRANSFER
  SUSPENDED_RESTORATION
  INACTIVE
}

enum DriverStatus {
  PENDING
  ACTIVE
  ON_LOAD
  SUSPENDED_TRANSFER
  SUSPENDED_RESTORATION
  INACTIVE
}

enum FleetStatus {
  INVITED
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  INACTIVE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
}

enum TransferStatus {
  PENDING
  PARTIAL
  APPROVED
  DECLINED
  CANCELLED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  ON_LOAD
  UNDER_MAINTENANCE
  INACTIVE
}

enum VehicleType {
  SEMI
  FLATBED
  REEFER
  BOX_TRUCK
  TANKER
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
}

// ── Models ───────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      Role
  isActive  Boolean  @default(true)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  fleetId String?
  fleet   Fleet?  @relation(fields: [fleetId], references: [id])

  // Dispatcher-specific
  dispatcherStatus DispatcherStatus?
  inviteToken      String?           @unique

  // Driver-specific
  driverStatus            DriverStatus?
  profilePhotoUrl         String?
  licenseNumber           String?
  licenseUrl              String?
  licenseExpiry           DateTime?
  licenseIsExpired        Boolean   @default(false)
  medicalCertificateUrl   String?
  hazmatCertificationUrl  String?
  backgroundCheckUrl      String?
  rejectionReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdLoads    Load[]      @relation("CreatedByDispatcher")
  assignedLoads   Load[]      @relation("AssignedToDriver")
  auditLogs       AuditLog[]

  // Dispatcher relations
  dispatcherStats         DispatcherStats?
  dispatcherAgencyHistory DispatcherAgencyHistory[]
  transferRequestsFrom    DispatcherTransferRequest[] @relation("TransferDispatcher")
  joinRequestsSent        DispatcherJoinRequest[]     @relation("JoinRequester")
  ratingsReceived         DispatcherRating[]          @relation("RatedDispatcher")
  ratingsGiven            DispatcherRating[]          @relation("RatingAuthor")

  // Driver relations
  driverStats         DriverStats?
  driverFleetHistory  DriverFleetHistory[]
  driverTransferRequests DriverTransferRequest[] @relation("DriverTransferUser")
  driverJoinRequests  DriverJoinRequest[]     @relation("DriverJoinUser")

  notifications Notification[]

  @@index([agencyId])
  @@index([fleetId])
  @@index([role])
}

model Agency {
  id   String @id @default(uuid())
  name String @unique

  // Branding
  logoUrl        String?
  primaryColor   String?  @default("#1a1a2e")
  secondaryColor String?  @default("#16213e")
  footerText     String?

  // Contact
  contactEmail String?
  contactPhone String?

  // Business
  commissionPercent Float            @default(10)
  paymentTermsDays  Int              @default(30)
  subscriptionPlan  SubscriptionPlan @default(FREE)

  // Subscription lifecycle
  subscriptionStartDate   DateTime?
  subscriptionEndDate     DateTime?
  subscriptionExpiresAt   DateTime?
  suspendedAt             DateTime?
  suspendedReason         String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  loads             Load[]
  agencyFleets      AgencyFleet[]
  invoices          Invoice[]
  receipts          Receipt[]
  fleetInvites      FleetInvite[]

  // Dispatcher relations
  dispatcherHistory     DispatcherAgencyHistory[]
  transferRequestsFrom  DispatcherTransferRequest[] @relation("TransferFromAgency")
  transferRequestsTo    DispatcherTransferRequest[] @relation("TransferToAgency")
  joinRequestsReceived  DispatcherJoinRequest[]     @relation("JoinTargetAgency")
}

model Fleet {
  id   String @id @default(uuid())
  name String @unique

  status    FleetStatus @default(INVITED)
  isActive  Boolean     @default(true)

  // Contact
  contactEmail String?
  contactPhone String?

  // Registration documents
  businessRegistrationUrl String?
  operatingLicenseUrl     String?
  operatingLicenseExpiry  DateTime?
  insuranceCertificateUrl String?
  insuranceCertificateExpiry DateTime?

  // Invite / registration flow
  inviteToken    String?  @unique
  invitedByAgencyId String?
  rejectionReason String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  vehicles           Vehicle[]
  agencyFleets       AgencyFleet[]
  loads              Load[]
  invoices           Invoice[]
  receipts           Receipt[]
  fleetInvites       FleetInvite[]

  // Driver relations
  driverTransferRequestsFrom DriverTransferRequest[] @relation("DriverTransferFromFleet")
  driverTransferRequestsTo   DriverTransferRequest[] @relation("DriverTransferToFleet")
  driverJoinRequestsReceived DriverJoinRequest[]     @relation("DriverJoinTargetFleet")
  driverFleetHistory         DriverFleetHistory[]
}

/// Tracks every agency that has invited a given fleet.
/// On SuperAdmin approval, AgencyFleet records are auto-created for each invite.
model FleetInvite {
  id       String @id @default(uuid())
  fleetId  String
  fleet    Fleet  @relation(fields: [fleetId], references: [id])
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([fleetId, agencyId])
  @@index([fleetId])
}

/// Junction table — an agency can work with many fleets, each with its own commission.
model AgencyFleet {
  id               String @id @default(uuid())
  agencyId         String
  fleetId          String
  commissionPercent Float  @default(10)

  agency Agency @relation(fields: [agencyId], references: [id])
  fleet  Fleet  @relation(fields: [fleetId], references: [id])

  createdAt DateTime @default(now())

  @@unique([agencyId, fleetId])
}

model Vehicle {
  id          String        @id @default(uuid())
  fleetId     String
  fleet       Fleet         @relation(fields: [fleetId], references: [id])

  make        String
  model       String
  year        Int
  vehicleType VehicleType
  plateNumber String        @unique
  vin         String?       @unique
  capacityTons Float?

  status      VehicleStatus @default(AVAILABLE)
  isActive    Boolean       @default(true)

  // Document expiry
  insuranceExpiry    DateTime?
  inspectionExpiry   DateTime?
  insuranceIsExpired Boolean   @default(false)
  inspectionIsExpired Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loads              Load[]
  maintenanceRecords MaintenanceRecord[]

  @@index([fleetId])
  @@index([status])
}

model MaintenanceRecord {
  id        String @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  type        MaintenanceType
  status      MaintenanceStatus @default(SCHEDULED)
  description String
  notes       String?
  cost        Float?

  scheduledDate DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}

model Load {
  id       String     @id @default(uuid())
  status   LoadStatus @default(DRAFT)

  // Relationships
  agencyId     String
  agency       Agency @relation(fields: [agencyId], references: [id])

  dispatcherId String
  dispatcher   User   @relation("CreatedByDispatcher", fields: [dispatcherId], references: [id])

  fleetId  String?
  fleet    Fleet?  @relation(fields: [fleetId], references: [id])

  driverId String?
  driver   User?   @relation("AssignedToDriver", fields: [driverId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  // Load details
  origin        String
  destination   String
  pickupDate    DateTime?
  deliveryDate  DateTime?
  commodity     String?
  weight        Float?
  notes         String?

  // Financial
  loadRate          Float?
  commissionPercent Float?
  commissionAmount  Float?
  dispatcherEarnings Float?
  fleetEarnings     Float?
  platformRevenue   Float?

  // POD
  podUrl String?

  // Lifecycle timestamps
  loadNumber              String?   @unique
  tripStartedAt           DateTime?
  deliverySubmittedAt     DateTime?
  deliveryAcceptedAt      DateTime?
  deliveryRejectedAt      DateTime?
  deliveryRejectionReason String?
  cancelledAt             DateTime?
  cancelledById           String?
  cancellationReason      String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoice       Invoice?
  statusHistory LoadStatusHistory[]

  @@index([agencyId])
  @@index([dispatcherId])
  @@index([fleetId])
  @@index([driverId])
  @@index([status])
  @@index([loadNumber])
}

model LoadStatusHistory {
  id            String     @id @default(uuid())
  loadId        String
  load          Load       @relation(fields: [loadId], references: [id])
  status        LoadStatus
  changedById   String?
  changedByRole Role?
  reason        String?

  createdAt DateTime @default(now())

  @@index([loadId])
  @@index([status])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  status        InvoiceStatus @default(UNPAID)

  // Relations
  loadId   String @unique   // one invoice per load
  load     Load   @relation(fields: [loadId], references: [id])
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])
  fleetId  String
  fleet    Fleet  @relation(fields: [fleetId], references: [id])

  // Financial snapshot (copied from load at generation time — never recalculated)
  loadRate           Float
  commissionPercent  Float  @default(0)
  commissionAmount   Float  @default(0)
  dispatcherEarnings Float  @default(0)
  fleetEarnings      Float

  // Dates
  generatedAt DateTime @default(now())
  dueDate     DateTime

  // Payment
  paidAt              DateTime?
  paidAmount          Float?
  paymentMethod       PaymentMethod?
  paymentReference    String?
  paymentNotes        String?
  paymentDate         DateTime?
  paymentRecordedById String?

  // Dispute
  isDisputed        Boolean   @default(false)
  disputeReason     String?
  disputeRaisedAt   DateTime?
  disputeRaisedById String?
  disputeResolvedAt DateTime?

  // PDF cache
  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipt Receipt?

  @@index([agencyId])
  @@index([fleetId])
  @@index([status])
  @@index([dueDate])
}

model Receipt {
  id            String @id @default(uuid())
  receiptNumber String @unique

  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  // Immutable snapshot — captured at generation time, never updated
  loadId     String
  agencyId   String
  agency     Agency @relation(fields: [agencyId], references: [id])
  agencyName String
  fleetId    String
  fleet      Fleet  @relation(fields: [fleetId], references: [id])
  fleetName  String
  driverName String?
  route      String         // "origin → destination"
  deliveryDate DateTime?

  // Financial snapshot
  loadRate           Float
  commissionPercent  Float
  commissionAmount   Float
  dispatcherEarnings Float
  fleetEarnings      Float

  // Payment details
  amountPaid       Float
  paymentMethod    PaymentMethod
  paymentReference String?
  paymentDate      DateTime
  recordedById     String
  recordedByName   String

  // PDF cache
  pdfUrl String?

  generatedAt DateTime @default(now())

  @@index([agencyId])
  @@index([fleetId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  statusCode Int?
  ip         String?
  payload    String?

  // Rich audit fields
  entityType String?
  entityId   String?
  oldValue   String?
  newValue   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

// ── Dispatcher module models ─────────────────────────────────────────

model DispatcherStats {
  id           String @id @default(uuid())
  dispatcherId String @unique
  dispatcher   User   @relation(fields: [dispatcherId], references: [id])

  totalLoadsCreated   Int   @default(0)
  totalLoadsCompleted Int   @default(0)
  totalLoadsCancelled Int   @default(0)
  completionRate      Float @default(0)
  onTimeDeliveryRate  Float @default(0)
  podAcceptanceRate   Float @default(0)
  disputeRate         Float @default(0)
  autoScore           Float @default(0)
  adminRatingAverage  Float @default(0)
  overallRating       Float @default(0)

  updatedAt DateTime @updatedAt
}

model DispatcherAgencyHistory {
  id           String    @id @default(uuid())
  dispatcherId String
  dispatcher   User      @relation(fields: [dispatcherId], references: [id])
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id])
  startDate    DateTime  @default(now())
  endDate      DateTime?

  @@index([dispatcherId])
  @@index([agencyId])
}

model DispatcherTransferRequest {
  id           String         @id @default(uuid())
  dispatcherId String
  dispatcher   User           @relation("TransferDispatcher", fields: [dispatcherId], references: [id])

  fromAgencyId String
  fromAgency   Agency         @relation("TransferFromAgency", fields: [fromAgencyId], references: [id])
  toAgencyId   String
  toAgency     Agency         @relation("TransferToAgency", fields: [toAgencyId], references: [id])

  status              TransferStatus @default(PENDING)
  fromAgencyApproved  Boolean?
  toAgencyApproved    Boolean?
  declineReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatcherId])
  @@index([status])
}

model DispatcherJoinRequest {
  id           String           @id @default(uuid())
  dispatcherId String
  dispatcher   User             @relation("JoinRequester", fields: [dispatcherId], references: [id])
  agencyId     String
  agency       Agency           @relation("JoinTargetAgency", fields: [agencyId], references: [id])

  status         JoinRequestStatus @default(PENDING)
  declineReason  String?
  cooldownUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatcherId])
  @@index([agencyId])
  @@index([status])
}

model DispatcherRating {
  id           String @id @default(uuid())
  dispatcherId String
  dispatcher   User   @relation("RatedDispatcher", fields: [dispatcherId], references: [id])
  authorId     String
  author       User   @relation("RatingAuthor", fields: [authorId], references: [id])

  score      Int      // 1-5
  comment    String?
  response   String?  // Dispatcher's response to the rating
  isFlagged  Boolean  @default(false)
  flagReason String?

  // Super Admin moderation
  isRemoved          Boolean   @default(false)
  removedAt          DateTime?
  removedByAdminId   String?
  removalReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatcherId])
  @@index([isFlagged])
}

// ── Driver module models ─────────────────────────────────────────────

model DriverStats {
  id       String @id @default(uuid())
  driverId String @unique
  driver   User   @relation(fields: [driverId], references: [id])

  totalLoadsCompleted Int   @default(0)
  onTimeDeliveryRate  Float @default(0)
  podAcceptanceRate   Float @default(0)
  disputeRate         Float @default(0)
  overallRating       Float @default(0)

  updatedAt DateTime @updatedAt
}

model DriverFleetHistory {
  id        String    @id @default(uuid())
  driverId  String
  driver    User      @relation(fields: [driverId], references: [id])
  fleetId   String
  fleet     Fleet     @relation(fields: [fleetId], references: [id])
  startDate DateTime  @default(now())
  endDate   DateTime?

  @@index([driverId])
  @@index([fleetId])
}

model DriverTransferRequest {
  id       String @id @default(uuid())
  driverId String
  driver   User   @relation("DriverTransferUser", fields: [driverId], references: [id])

  fromFleetId String
  fromFleet   Fleet  @relation("DriverTransferFromFleet", fields: [fromFleetId], references: [id])
  toFleetId   String
  toFleet     Fleet  @relation("DriverTransferToFleet", fields: [toFleetId], references: [id])

  status            TransferStatus @default(PENDING)
  fromFleetApproved Boolean?
  toFleetApproved   Boolean?
  declineReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([status])
}

model DriverJoinRequest {
  id       String @id @default(uuid())
  driverId String
  driver   User   @relation("DriverJoinUser", fields: [driverId], references: [id])
  fleetId  String
  fleet    Fleet  @relation("DriverJoinTargetFleet", fields: [fleetId], references: [id])

  status          JoinRequestStatus @default(PENDING)
  declineReason   String?
  reasonForLeaving String?
  cooldownUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([fleetId])
  @@index([status])
}

// ── Notification model ──────────────────────────────────────────────

model Notification {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])

  type    String          // e.g. LOAD_ASSIGNED, INVOICE_OVERDUE, TRANSFER_REQUESTED
  title   String
  message String
  data    String?         // JSON payload for deep linking

  isRead  Boolean @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ── Platform settings (singleton — one row) ─────────────────────────

model PlatformSettings {
  id                        String  @id @default(uuid())
  platformName              String  @default("Dispatch-365")
  platformLogoUrl           String?
  primaryColor              String  @default("#0f3460")
  secondaryColor            String  @default("#16213e")
  supportEmail              String?
  supportPhone              String?
  platformWatermarkEnabled  Boolean @default(true)
  watermarkText             String? @default("Powered by Dispatch-365")
  poweredByText             String? @default("Powered by Dispatch-365")

  // Reminder thresholds (days)
  invoiceDueReminderDays      Int @default(3)
  transferReminderDays        Int @default(7)
  documentExpiryWarningDays   Int @default(30)
  maintenanceReminderDays     Int @default(7)

  // Cooldowns (days)
  fleetReRequestCooldown    Int @default(30)
  agencyReRequestCooldown   Int @default(30)
  dispatcherJoinCooldown    Int @default(30)

  // Subscription
  trialPeriodDays     Int     @default(14)
  gracePeriodDays     Int     @default(7)
  autoSuspendOnExpiry Boolean @default(true)

  // Session / security
  webSessionTimeoutMinutes    Int @default(30)
  mobileSessionTimeoutMinutes Int @default(60)
  maxFailedLoginAttempts      Int @default(5)
  loginLockoutMinutes         Int @default(15)

  updatedAt DateTime @updatedAt
}

// ── Subscription plan configuration ────────────────────────────────

model SubscriptionPlanConfig {
  id               String           @id @default(uuid())
  plan             SubscriptionPlan @unique
  priceMonthly     Float            @default(0)
  maxDispatchers   Int              @default(5)
  maxLoadsPerMonth Int              @default(100)
  features         String?          // JSON array of feature strings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
