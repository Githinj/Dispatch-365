generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────

enum Role {
  SuperAdmin
  AgencyAdmin
  Dispatcher
  FleetAdmin
  Driver
}

enum LoadStatus {
  DRAFT
  ASSIGNED
  IN_TRANSIT
  PENDING_DELIVERY_CONFIRMATION
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DispatcherStatus {
  PENDING
  ACTIVE
  SUSPENDED_TRANSFER
  SUSPENDED_RESTORATION
  INACTIVE
}

enum DriverStatus {
  PENDING
  ACTIVE
  ON_LOAD
  SUSPENDED_TRANSFER
  SUSPENDED_RESTORATION
  INACTIVE
}

enum FleetStatus {
  INVITED
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  INACTIVE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
}

enum TransferStatus {
  PENDING
  PARTIAL
  APPROVED
  DECLINED
  CANCELLED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ── Models ───────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      Role
  isActive  Boolean  @default(true)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  fleetId String?
  fleet   Fleet?  @relation(fields: [fleetId], references: [id])

  // Dispatcher-specific
  dispatcherStatus DispatcherStatus?
  inviteToken      String?           @unique

  // Driver-specific
  driverStatus            DriverStatus?
  profilePhotoUrl         String?
  licenseNumber           String?
  licenseUrl              String?
  licenseExpiry           DateTime?
  licenseIsExpired        Boolean   @default(false)
  medicalCertificateUrl   String?
  hazmatCertificationUrl  String?
  backgroundCheckUrl      String?
  rejectionReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdLoads    Load[]      @relation("CreatedByDispatcher")
  assignedLoads   Load[]      @relation("AssignedToDriver")
  auditLogs       AuditLog[]
  invoicesCreated Invoice[]

  // Dispatcher relations
  dispatcherStats         DispatcherStats?
  dispatcherAgencyHistory DispatcherAgencyHistory[]
  transferRequestsFrom    DispatcherTransferRequest[] @relation("TransferDispatcher")
  joinRequestsSent        DispatcherJoinRequest[]     @relation("JoinRequester")
  ratingsReceived         DispatcherRating[]          @relation("RatedDispatcher")
  ratingsGiven            DispatcherRating[]          @relation("RatingAuthor")

  // Driver relations
  driverStats         DriverStats?
  driverFleetHistory  DriverFleetHistory[]
  driverTransferRequests DriverTransferRequest[] @relation("DriverTransferUser")
  driverJoinRequests  DriverJoinRequest[]     @relation("DriverJoinUser")

  @@index([agencyId])
  @@index([fleetId])
  @@index([role])
}

model Agency {
  id   String @id @default(uuid())
  name String @unique

  // Branding
  logoUrl        String?
  primaryColor   String?  @default("#1a1a2e")
  secondaryColor String?  @default("#16213e")
  footerText     String?

  // Business
  commissionPercent Float            @default(10)
  paymentTermsDays  Int              @default(30)
  subscriptionPlan  SubscriptionPlan @default(FREE)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  loads             Load[]
  agencyFleets      AgencyFleet[]
  invoices          Invoice[]
  fleetInvites      FleetInvite[]

  // Dispatcher relations
  dispatcherHistory     DispatcherAgencyHistory[]
  transferRequestsFrom  DispatcherTransferRequest[] @relation("TransferFromAgency")
  transferRequestsTo    DispatcherTransferRequest[] @relation("TransferToAgency")
  joinRequestsReceived  DispatcherJoinRequest[]     @relation("JoinTargetAgency")
}

model Fleet {
  id   String @id @default(uuid())
  name String @unique

  status    FleetStatus @default(INVITED)
  isActive  Boolean     @default(true)

  // Contact
  contactEmail String?
  contactPhone String?

  // Registration documents
  businessRegistrationUrl String?
  operatingLicenseUrl     String?
  operatingLicenseExpiry  DateTime?
  insuranceCertificateUrl String?
  insuranceCertificateExpiry DateTime?

  // Invite / registration flow
  inviteToken    String?  @unique
  invitedByAgencyId String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  vehicles     Vehicle[]
  agencyFleets AgencyFleet[]
  loads        Load[]
  fleetInvites FleetInvite[]

  // Driver relations
  driverTransferRequestsFrom DriverTransferRequest[] @relation("DriverTransferFromFleet")
  driverTransferRequestsTo   DriverTransferRequest[] @relation("DriverTransferToFleet")
  driverJoinRequestsReceived DriverJoinRequest[]     @relation("DriverJoinTargetFleet")
  driverFleetHistory         DriverFleetHistory[]
}

/// Tracks every agency that has invited a given fleet.
/// On SuperAdmin approval, AgencyFleet records are auto-created for each invite.
model FleetInvite {
  id       String @id @default(uuid())
  fleetId  String
  fleet    Fleet  @relation(fields: [fleetId], references: [id])
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([fleetId, agencyId])
  @@index([fleetId])
}

/// Junction table — an agency can work with many fleets, each with its own commission.
model AgencyFleet {
  id               String @id @default(uuid())
  agencyId         String
  fleetId          String
  commissionPercent Float  @default(10)

  agency Agency @relation(fields: [agencyId], references: [id])
  fleet  Fleet  @relation(fields: [fleetId], references: [id])

  createdAt DateTime @default(now())

  @@unique([agencyId, fleetId])
}

model Vehicle {
  id              String  @id @default(uuid())
  fleetId         String
  fleet           Fleet   @relation(fields: [fleetId], references: [id])
  make            String
  model           String
  year            Int
  licensePlate    String  @unique
  vin             String? @unique
  isUnderMaintenance Boolean @default(false)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loads Load[]

  @@index([fleetId])
}

model Load {
  id       String     @id @default(uuid())
  status   LoadStatus @default(DRAFT)

  // Relationships
  agencyId     String
  agency       Agency @relation(fields: [agencyId], references: [id])

  dispatcherId String
  dispatcher   User   @relation("CreatedByDispatcher", fields: [dispatcherId], references: [id])

  fleetId  String?
  fleet    Fleet?  @relation(fields: [fleetId], references: [id])

  driverId String?
  driver   User?   @relation("AssignedToDriver", fields: [driverId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  // Load details
  origin        String
  destination   String
  pickupDate    DateTime?
  deliveryDate  DateTime?
  commodity     String?
  weight        Float?
  notes         String?

  // Financial
  loadRate          Float?
  commissionPercent Float?
  commissionAmount  Float?
  dispatcherEarnings Float?
  fleetEarnings     Float?
  platformRevenue   Float?

  // POD
  podUrl String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoices Invoice[]

  @@index([agencyId])
  @@index([dispatcherId])
  @@index([fleetId])
  @@index([driverId])
  @@index([status])
}

model Invoice {
  id     String        @id @default(uuid())
  status InvoiceStatus @default(UNPAID)

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  loadId String
  load   Load   @relation(fields: [loadId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  amount      Float
  dueDate     DateTime
  paidAt      DateTime?
  paidAmount  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([loadId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  statusCode Int?
  ip         String?
  payload    String?

  // Rich audit fields
  entityType String?
  entityId   String?
  oldValue   String?
  newValue   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

// ── Dispatcher module models ─────────────────────────────────────────

model DispatcherStats {
  id           String @id @default(uuid())
  dispatcherId String @unique
  dispatcher   User   @relation(fields: [dispatcherId], references: [id])

  totalLoadsCreated   Int   @default(0)
  totalLoadsCompleted Int   @default(0)
  totalLoadsCancelled Int   @default(0)
  completionRate      Float @default(0)
  onTimeDeliveryRate  Float @default(0)
  podAcceptanceRate   Float @default(0)
  disputeRate         Float @default(0)
  autoScore           Float @default(0)
  adminRatingAverage  Float @default(0)
  overallRating       Float @default(0)

  updatedAt DateTime @updatedAt
}

model DispatcherAgencyHistory {
  id           String    @id @default(uuid())
  dispatcherId String
  dispatcher   User      @relation(fields: [dispatcherId], references: [id])
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id])
  startDate    DateTime  @default(now())
  endDate      DateTime?

  @@index([dispatcherId])
  @@index([agencyId])
}

model DispatcherTransferRequest {
  id           String         @id @default(uuid())
  dispatcherId String
  dispatcher   User           @relation("TransferDispatcher", fields: [dispatcherId], references: [id])

  fromAgencyId String
  fromAgency   Agency         @relation("TransferFromAgency", fields: [fromAgencyId], references: [id])
  toAgencyId   String
  toAgency     Agency         @relation("TransferToAgency", fields: [toAgencyId], references: [id])

  status              TransferStatus @default(PENDING)
  fromAgencyApproved  Boolean?
  toAgencyApproved    Boolean?
  declineReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatcherId])
  @@index([status])
}

model DispatcherJoinRequest {
  id           String           @id @default(uuid())
  dispatcherId String
  dispatcher   User             @relation("JoinRequester", fields: [dispatcherId], references: [id])
  agencyId     String
  agency       Agency           @relation("JoinTargetAgency", fields: [agencyId], references: [id])

  status         JoinRequestStatus @default(PENDING)
  declineReason  String?
  cooldownUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatcherId])
  @@index([agencyId])
  @@index([status])
}

model DispatcherRating {
  id           String @id @default(uuid())
  dispatcherId String
  dispatcher   User   @relation("RatedDispatcher", fields: [dispatcherId], references: [id])
  authorId     String
  author       User   @relation("RatingAuthor", fields: [authorId], references: [id])

  score      Int      // 1-5
  comment    String?
  response   String?  // Dispatcher's response to the rating
  isFlagged  Boolean  @default(false)
  flagReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatcherId])
}

// ── Driver module models ─────────────────────────────────────────────

model DriverStats {
  id       String @id @default(uuid())
  driverId String @unique
  driver   User   @relation(fields: [driverId], references: [id])

  totalLoadsCompleted Int   @default(0)
  onTimeDeliveryRate  Float @default(0)
  podAcceptanceRate   Float @default(0)
  disputeRate         Float @default(0)
  overallRating       Float @default(0)

  updatedAt DateTime @updatedAt
}

model DriverFleetHistory {
  id        String    @id @default(uuid())
  driverId  String
  driver    User      @relation(fields: [driverId], references: [id])
  fleetId   String
  fleet     Fleet     @relation(fields: [fleetId], references: [id])
  startDate DateTime  @default(now())
  endDate   DateTime?

  @@index([driverId])
  @@index([fleetId])
}

model DriverTransferRequest {
  id       String @id @default(uuid())
  driverId String
  driver   User   @relation("DriverTransferUser", fields: [driverId], references: [id])

  fromFleetId String
  fromFleet   Fleet  @relation("DriverTransferFromFleet", fields: [fromFleetId], references: [id])
  toFleetId   String
  toFleet     Fleet  @relation("DriverTransferToFleet", fields: [toFleetId], references: [id])

  status            TransferStatus @default(PENDING)
  fromFleetApproved Boolean?
  toFleetApproved   Boolean?
  declineReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([status])
}

model DriverJoinRequest {
  id       String @id @default(uuid())
  driverId String
  driver   User   @relation("DriverJoinUser", fields: [driverId], references: [id])
  fleetId  String
  fleet    Fleet  @relation("DriverJoinTargetFleet", fields: [fleetId], references: [id])

  status          JoinRequestStatus @default(PENDING)
  declineReason   String?
  reasonForLeaving String?
  cooldownUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([fleetId])
  @@index([status])
}
